    <!-- Reglas: cada grupo solo ve su categoria (los publicos se ven) -->
    <record id="rule_wiki_article_admin" model="ir.rule">
        <field name="name">Wiki Article: Admin ve todo</field>
        <field name="model_id" ref="model_wiki_article"/>
        <field name="groups" eval="[(4, ref('wiki_interna.group_wiki_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_wiki_article_socios" model="ir.rule">
        <field name="name">Wiki Article: Socios ve todo</field>
        <field name="model_id" ref="model_wiki_article"/>
        <field name="groups" eval="[(4, ref('wiki_interna.group_wiki_socios'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
        <record id="rule_wiki_article_oficina" model="ir.rule">
        <field name="name">Wiki Article: Oficina (lectura)</field>
        <field name="model_id" ref="model_wiki_article"/>
        <field name="groups" eval="[(4, ref('wiki_interna.group_wiki_oficina'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', ('is_public', '=', True), ('category_id.name', '=', 'Oficina')]</field>
    </record>
    <record id="rule_wiki_article_oficina_write" model="ir.rule">
        <field name="name">Wiki Article: Oficina (edicion)</field>
        <field name="model_id" ref="model_wiki_article"/>
        <field name="groups" eval="[(4, ref('wiki_interna.group_wiki_oficina'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">['&amp;', ('category_id.name', '=', 'Oficina'), ('is_locked', '=', False)]</field>
    </record>
